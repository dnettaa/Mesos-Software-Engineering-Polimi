<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.polimi.ingsw.view.GUI.GUIGameController"
           prefWidth="1280" prefHeight="800">

    <!-- Full-screen background stretched to window size by GUI.java -->
    <ImageView fx:id="backgroundImage" preserveRatio="false">
        <image>
            <Image url="/GUI-resources/images/wallpaper_no_logo.png"/>
        </image>
    </ImageView>

    <!-- Fixed-size root pane scaled proportionally by GUI.java on resize -->
    <StackPane fx:id="scalablePane"
               prefWidth="1280" prefHeight="800"
               maxWidth="1280" maxHeight="800">

        <BorderPane prefWidth="1280" prefHeight="800"
                    maxWidth="1280" maxHeight="800"
                    style="-fx-padding: 14;">

            <!-- ========================= TOP BAR ========================= -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="18"
                      styleClass="game-top-bar">
                    <BorderPane.margin>
                        <Insets bottom="10"/>
                    </BorderPane.margin>

                    <!-- Round + Era badges -->
                    <VBox spacing="3" alignment="CENTER_LEFT">
                        <Label fx:id="roundLabel"
                               text="ROUND —"
                               styleClass="game-title-label"/>
                        <Label fx:id="eraLabel"
                               text="ERA: —"
                               styleClass="game-era-label"/>
                    </VBox>

                    <Separator orientation="VERTICAL"
                               style="-fx-background-color: #a07040; -fx-opacity: 0.5; -fx-pref-width: 1;"/>

                    <!-- Phase + active player (takes remaining space) -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label fx:id="phaseLabel"
                               text="—"
                               styleClass="game-phase-label"/>
                        <Label fx:id="activePlayerLabel"
                               text="Turn: —"
                               styleClass="game-info-label"/>
                    </VBox>

                    <!-- Local player identity -->
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="YOU ARE"
                               styleClass="game-small-label"/>
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <ImageView fx:id="myTotemImage"
                                       fitHeight="26" preserveRatio="true"/>
                            <Label fx:id="nicknameLabel"
                                   text="—"
                                   styleClass="game-player-name-label"/>
                        </HBox>
                    </VBox>
                </HBox>
            </top>

            <!-- ========================= CENTER BOARD ========================= -->
            <center>
                <VBox spacing="8" alignment="TOP_CENTER"
                      style="-fx-padding: 6 8 0 0;">

                    <!-- Upper card row with subtle dark backdrop -->
                    <StackPane style="-fx-background-color: rgba(0,0,0,0.32); -fx-background-radius: 10;">
                        <ScrollPane hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    fitToHeight="true"
                                    fitToWidth="true"
                                    prefHeight="175" minHeight="175" maxHeight="175"
                                    styleClass="game-transparent-scroll">
                            <HBox fx:id="upperRowBox"
                                  spacing="10" alignment="CENTER"
                                  style="-fx-padding: 4 10;"/>
                        </ScrollPane>
                    </StackPane>

                    <!-- Turn order + offer track: single flat row -->
                    <HBox fx:id="trackRowBox"
                          spacing="8" alignment="CENTER" prefHeight="175"
                          style="-fx-background-color: rgba(0,0,0,0.32); -fx-background-radius: 10; -fx-padding: 4;"/>

                    <!-- Lower card row with subtle dark backdrop -->
                    <StackPane style="-fx-background-color: rgba(0,0,0,0.32); -fx-background-radius: 10;">
                        <ScrollPane hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    fitToHeight="true"
                                    fitToWidth="true"
                                    prefHeight="175" minHeight="175" maxHeight="175"
                                    styleClass="game-transparent-scroll">
                            <HBox fx:id="lowerRowBox"
                                  spacing="10" alignment="CENTER"
                                  style="-fx-padding: 4 10;"/>
                        </ScrollPane>
                    </StackPane>

                    <!-- Action area -->
                    <VBox spacing="8" alignment="CENTER"
                          styleClass="game-action-panel">
                        <Label fx:id="messageLabel"
                               text="Waiting for game state…"
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="game-message-label"/>

                        <Label fx:id="errorLabel"
                               visible="false" managed="true"
                               wrapText="true" textAlignment="CENTER"
                               styleClass="game-error-label"/>
                    </VBox>

                </VBox>
            </center>

            <!-- ========================= RIGHT SIDE PANEL ========================= -->
            <right>
                <VBox fx:id="rightPanel"
                      spacing="8"
                      prefWidth="300" maxWidth="300"
                      style="-fx-padding: 0 0 0 10;">

                    <!-- Local player tribe and resources -->
                    <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="game-side-panel">
                        <Label text="MY TRIBE"
                               styleClass="game-section-title"/>

                        <HBox spacing="20" alignment="CENTER_LEFT">
                            <Label fx:id="myFoodLabel"
                                   text="Food: —"
                                   styleClass="game-info-label"/>
                            <Label fx:id="myPPLabel"
                                   text="PP: —"
                                   styleClass="game-info-label"/>
                        </HBox>

                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    VBox.vgrow="ALWAYS"
                                    styleClass="game-transparent-scroll">
                            <VBox fx:id="myTribeBox"
                                  spacing="8"
                                  style="-fx-padding: 4;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- Other players (scrollable so any player count fits) -->
                    <VBox spacing="6" prefHeight="220"
                          styleClass="game-side-panel">
                        <Label text="PLAYERS"
                               styleClass="game-section-title"/>
                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    prefHeight="170"
                                    styleClass="game-transparent-scroll">
                            <VBox fx:id="playersBox"
                                  spacing="6"
                                  style="-fx-padding: 2;"/>
                        </ScrollPane>
                    </VBox>


                </VBox>
            </right>

        </BorderPane>
    </StackPane>

</StackPane>
